# PocketBase URL — set to your PocketBase instance
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Twilio credentials (used by Netlify Functions only, never exposed to client)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Ontario Data Catalogue CKAN API base
VITE_CKAN_API_BASE=https://data.ontario.ca/api/3

# Foodland Ontario recipes portal (for deep-linking)
VITE_FOODLAND_RECIPES_URL=https://www.ontario.ca/foodland/recipes
